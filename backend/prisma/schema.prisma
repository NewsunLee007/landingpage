generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id       String   @id @default(cuid())
  username String   @unique
  password String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id       String   @id
  title    String
  content  String
  date     String
  summary  String
  imageUrl String?
  tags     String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AppItem {
  id          String   @id
  title       String
  description String
  url         String
  category    String
  tags        String   @default("[]")
  iconName    String
  imageUrl    String?
  isPrivate   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
